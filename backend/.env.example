PORT=3333
NODE_ENV=development
STAFF_INVITE_CODE=cineray-staff
# Obrigatório — sem fallback no código. Gere com: openssl rand -hex 32
TICKET_QR_SECRET=
TMDB_API_KEY=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cineray
MYSQL_PASSWORD=cineray
MYSQL_DATABASE=cineray
# Aiven / MySQL gerenciado: MYSQL_SSL=required
# MYSQL_SSL=required
# Timeout de conexão (ms). Evita hang infinito no boot do Render.
# MYSQL_CONNECT_TIMEOUT=10000

# URL pública do front (links /i/:shareToken e passe Google Wallet)
# Local: http://localhost:5173 | Produção: https://seu-app.vercel.app
APP_PUBLIC_URL=http://localhost:5173

# Google Wallet — https://pay.google.com/business/console
# GOOGLE_WALLET_ISSUER_ID=3388000000022...
# GOOGLE_WALLET_SA_EMAIL=cineray-wallet@seu-projeto.iam.gserviceaccount.com
# GOOGLE_WALLET_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_WALLET_ORIGINS=http://localhost:5173
# GOOGLE_WALLET_CLASS_SUFFIX=cineray_event_ticket
# Ative a API no GCP: https://console.developers.google.com/apis/api/walletobjects.googleapis.com/overview

# Schema: backend/migrations (Knex). O boot aplica pendentes via initDb.
# Seed demo (contas + catálogo). Desligue em produção “limpa” se quiser:
# DISABLE_SEED=1

PORT=3333
NODE_ENV=development
STAFF_INVITE_CODE=cineray-staff
# Obrigatório — sem fallback no código. Gere com: openssl rand -hex 32
TICKET_QR_SECRET=
TMDB_API_KEY=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cineray
MYSQL_PASSWORD=cineray
MYSQL_DATABASE=cineray
# Aiven / MySQL gerenciado: MYSQL_SSL=required
# MYSQL_SSL=required
# Timeout de conexão (ms). Evita hang infinito no boot do Render.
# MYSQL_CONNECT_TIMEOUT=10000

# URL pública do front (links /i/:shareToken)
# Local: http://localhost:5173 | Produção: https://seu-app.vercel.app
APP_PUBLIC_URL=http://localhost:5173

# Schema: backend/migrations (Knex). O boot aplica pendentes via initDb.
# Seed demo (contas + catálogo). Desligue em produção “limpa” se quiser:
# DISABLE_SEED=1
